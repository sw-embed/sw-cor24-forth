command = '''scripts/run-kernel.sh forth.s -u 'DROP\n42 .\n' --speed 0 -n 10000000 --stack-bounds none 2>&1'''
timeout = 30
preprocess = "grep -A 100 '^UART output:' || true"
exit_code = 0
desc = "DROP on empty stack caught by QUIT check (the emulator's own SP bounds check is off so Forth's check is what runs)"
