command = "out=$(mktemp) && XC_SOURCE=forth-from-forth/compiler/tests/features.fth XC_OUT=$out forth-from-forth/scripts/build-kernel.sh >/dev/null 2>&1; cat $out; rm -f $out"
timeout = 600
preprocess = "cat"
exit_code = 0
desc = "cross-compiler features: comments, literals incl. negative, ['], IMMEDIATE, self-reference, name mangling, unresolved token reported"
