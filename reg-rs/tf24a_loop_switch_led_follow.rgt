command = '''scripts/run-kernel.sh forth.s -u "$(cat examples/13-loop-switch-led.fth)
" --switch-at 6000000:on,8000000:off,10000000:on --speed 0 -n 12000000 2>&1'''
timeout = 60
preprocess = "grep -E '^\\[(S2|LED) @|^Stack (over|under)flow' || true"
exit_code = 0
desc = "13-loop-switch-led: D2 follows each S2 toggle while MIRROR runs (regression: stack leak halted the CPU)"
